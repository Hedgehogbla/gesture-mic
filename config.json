{
  "camera": {
    "index": 0,
    "width": 640,
    "height": 480,
    "mirror": true
  },
  "hand_landmarker": {
    "model_path": "models/hand_landmarker.task",
    "num_hands": 1,
    "min_detection_confidence": 0.6,
    "min_presence_confidence": 0.6,
    "min_tracking_confidence": 0.6
  },
  "gesture": {
    "hold_ms": 500,
    "cooldown_ms": 1500,
    "extended_angle": 150.0,
    "curled_angle": 100.0
  },
  "actions": {
    "closed_fist": "mute",
    "open_palm": "unmute",
    "victory": "toggle"
  },
  "safety": {
    "skip_mute_while_recording": true,
    "restore_mic_on_exit": true
  },
  "feedback": {
    "beep": true,
    "show_preview": true
  }
}
