{
  "camera": {
    "index": 0,
    "width": 640,
    "height": 480,
    "mirror": true
  },
  "hand_landmarker": {
    "model_path": "models/hand_landmarker.task",
    "num_hands": 1,
    "min_detection_confidence": 0.6,
    "min_presence_confidence": 0.6,
    "min_tracking_confidence": 0.6
  },
  "gesture": {
    "hold_ms": 500,
    "cooldown_ms": 1200,
    "extended_angle": 150.0
  },
  "mute": {
    "backend": "discord_hotkey",
    "hotkey": "ctrl+shift+m"
  },
  "actions": {
    "point": "toggle",
    "closed_fist": "play_pause",
    "thumb_right": "next_track",
    "thumb_left": "prev_track"
  },
  "feedback": {
    "show_preview": true,
    "beep": true
  }
}
